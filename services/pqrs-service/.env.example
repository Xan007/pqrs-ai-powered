# PQRS Domain Microservice Environment Variables

# Server Configuration
PORT=8002
HOST=0.0.0.0

# Database Configuration (Database-per-service pattern: pqrs_db)
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5434/pqrs_db

# Enterprise Configuration (Dynamic Triage)
COMPANY_CATEGORIES="PETITION,COMPLAINT,CLAIM,SUGGESTION"
COMPANY_PRIORITIES="LOW,MEDIUM,HIGH,CRITICAL"
COMPANY_DEPARTMENTS="Technical Support,Billing,Customer Care,Legal,Logistics,Network Operations"

# AI Engine (Groq API)
GROQ_API_KEY=your_groq_api_key_here

# Redis Configuration (BullMQ async processing)
REDIS_HOST=localhost
REDIS_PORT=6379
# Only for managed Redis (e.g. Azure Managed Redis)
REDIS_PASSWORD=
REDIS_TLS=false

# RabbitMQ (consumes UserRegistered from pqrs.user.registered.queue)
# Leave empty to disable the event consumers
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=microservices.events
RABBITMQ_PREFETCH=10
