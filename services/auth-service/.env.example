# Authentication Microservice Environment Variables

# Server Configuration
PORT=8001
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5434/auth_db

# Security & JWT
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial admin (used by `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# RabbitMQ (publishes UserRegistered to the microservices.events exchange)
# Leave empty to disable event publishing
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=microservices.events
